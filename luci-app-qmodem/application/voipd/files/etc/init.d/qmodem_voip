#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1

qmodem_voip_interface_address()
{
	interface=$(uci -q get qmodem_voip.sip.interface)
	interface=${interface:-br-lan}
	case $interface in ''|*[!A-Za-z0-9_.:-]*) return 1 ;; esac
	status=$(ubus -t 2 call "network.interface.$interface" status 2>/dev/null) || status=
	device=$(printf '%s\n' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null)
	device=${device:-$interface}
	ip -4 -o addr show dev "$device" scope global 2>/dev/null |
		awk 'NR == 1 { sub(/\/.*/, "", $4); print $4 }'
}

qmodem_voip_start_registrar()
{
	lan_address=$1
	engine=$(uci -q get qmodem_voip.sip.engine)
	engine=${engine:-consumer}
	media_socket_path=$2
	[ "$(uci -q get qmodem_voip.main.enabled)" = 1 ] || return 0
	[ "$(uci -q get qmodem_voip.sip.enabled)" = 1 ] || return 0
	case "$engine" in
	consumer|registrar) ;;
	*)
		logger -t qmodem_voip "unsupported SIP engine: $engine"
		return 1
		;;
	esac
	procd_open_instance registrar
	case "$engine" in
	consumer)
		procd_set_param command /usr/sbin/qmodem_voip_consumer_wait \
			--listen-address 0.0.0.0 --advertise-address "$lan_address" \
			--media-socket-path "$media_socket_path"
		;;
	registrar)
		procd_set_param command /usr/sbin/qmodem_voip_registrar_wait --listen-address 0.0.0.0 --advertise-address "$lan_address"
		;;
	esac
	procd_set_param respawn 3600 5 5
	procd_close_instance
	ubus call service event '{"type":"firewall","data":{"reload":true}}' >/dev/null 2>&1 || :
}

start_service()
{
	mkdir -p -m 700 /etc/qmodem_voip
	mkdir -p -m 700 /var/run/qmodem_voip
	mkdir -p -m 700 /var/lib/qmodem_voip
	interface=$(uci -q get qmodem_voip.sip.interface)
	interface=${interface:-br-lan}
	case $interface in ''|*[!A-Za-z0-9_.:-]*) return 1 ;; esac
	lan_address=$(qmodem_voip_interface_address)
	media_socket_path=$(uci -q get qmodem_voip.sip.media_socket_path)
	media_socket_path=${media_socket_path:-/var/run/qmodem_voip/media.sock}
	enabled=$(uci -q get qmodem_voip.main.enabled)
	case $enabled in 1) ;; *) enabled=0 ;; esac
	procd_open_instance
	procd_set_param command /usr/sbin/qmodem_voip_daemon_wait \
		--media-interface "$interface" \
		--media-cert /dev/null \
		--media-key /dev/null \
		--media-socket-path "$media_socket_path" \
		--start-enabled "$enabled"
	procd_set_param respawn 3600 5 5
	procd_close_instance

	[ -n "$lan_address" ] && qmodem_voip_start_registrar "$lan_address" "$media_socket_path"
	/usr/sbin/qmodem_voip_web
}

reload_service()
{
	stop
	start
	/usr/sbin/qmodem_voip_web
}

service_triggers()
{
	procd_add_reload_trigger qmodem_voip
}
