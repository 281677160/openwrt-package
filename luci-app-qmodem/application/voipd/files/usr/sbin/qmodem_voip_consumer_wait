#!/bin/sh
# Wait for the VoIP daemon to report a ready media engine and media socket
# before execing the SIP consumer, then hand over all arguments unchanged.
remaining=60
recovery_attempted=0
while [ "$remaining" -gt 0 ]; do
	status=$(ubus -t 2 call qmodem_voip status 2>/dev/null) || status=
	if [ "$(printf '%s\n' "$status" | jsonfilter -e '@.media_engine' 2>/dev/null)" = ready ]; then
		exec /usr/bin/qmodem_voip_sip_consumer "$@"
	fi
	if [ "$recovery_attempted" = 0 ] && [ -n "$status" ]; then
		recovery_attempted=1
		ubus -t 120 call qmodem_voip enable >/dev/null 2>&1 || :
	fi
	remaining=$((remaining - 1))
	sleep 1
done
logger -t qmodem_voip 'media daemon did not become ready; SIP consumer remains stopped'
exit 1
