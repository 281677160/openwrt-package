#!/bin/sh
remaining=15
while [ "$remaining" -gt 0 ]; do
	status=$(ubus -t 2 call qmodem_voip status 2>/dev/null) || status=
	if [ "$(printf '%s\n' "$status" | jsonfilter -e '@.media_engine' 2>/dev/null)" = ready ]; then
		exec /usr/bin/qmodem_voip_registrar "$@"
	fi
	remaining=$((remaining - 1))
	sleep 1
done
logger -t qmodem_voip 'media daemon did not become ready; SIP registrar remains stopped'
exit 1
