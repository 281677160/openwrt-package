#!/bin/sh
# EDL 保护（hotplug 侧）
#
# 模块以 05c6:9008 (Qualcomm EDL) 枚举时，PBL 只发送一次 Sahara hello，
# 任何往 ttyUSB0 发 AT 命令的探测进程都会让 PBL 进入错误状态，之后只能断电重来。
# 开机时模块若已处于 EDL（例如上次烧录中断），qmodem 的 modem_scand 会在
# 用户来得及点击烧录前就把 PBL 打坏。这里在 9008 出现的瞬间停掉探测服务，
# 在 9008 消失（烧录完成、模块重启）时恢复。

[ "$DEVTYPE" = "usb_device" ] || exit 0

case "$PRODUCT" in
    5c6/9008/*) ;;
    *) exit 0 ;;
esac

LOG_DIR="/tmp/qfirehose_log"
stopped_file="$LOG_DIR/stopped_services"
EDL_GUARD_SERVICES="qmodem_init qmodem_monitor ubus-at-daemon"

mkdir -p "$LOG_DIR"

case "$ACTION" in
    add)
        for s in $EDL_GUARD_SERVICES; do
            [ -x "/etc/init.d/$s" ] || continue
            if /etc/init.d/"$s" stop >/dev/null 2>&1; then
                grep -qx "$s" "$stopped_file" 2>/dev/null || echo "$s" >> "$stopped_file"
            fi
        done
        killall modem_scand 2>/dev/null
        logger -t qfirehose "EDL device detected, modem probing services stopped"
        ;;
    remove)
        [ -f "$stopped_file" ] || exit 0
        for s in $(cat "$stopped_file"); do
            /etc/init.d/"$s" start >/dev/null 2>&1
        done
        rm -f "$stopped_file"
        logger -t qfirehose "EDL device removed, modem probing services restored"
        ;;
esac
