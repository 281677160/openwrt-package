#!/bin/sh
# EDL 保护（hotplug 侧），详见 /usr/sbin/qfirehose-edl-guard
#
# 05c6:9008 设备的任何接口一旦被内核驱动（qcserial）绑定，立刻解绑，
# 使系统中不存在对应的 /dev/ttyUSB*，任何用户态程序都无法向 PBL 发送数据。
# qfirehose 通过 usbfs 直接访问设备，不受影响。
# 文件名以 05 开头，保证在其他 hotplug 脚本（modem 探测等）之前执行。

case "$PRODUCT" in
    5c6/9008/*) ;;
    *) exit 0 ;;
esac

case "$DEVTYPE:$ACTION" in
    usb_interface:add|usb_interface:bind)
        /usr/sbin/qfirehose-edl-guard detach "/sys$DEVPATH"
        ;;
    usb_device:add)
        /usr/sbin/qfirehose-edl-guard detach "/sys$DEVPATH"
        /usr/sbin/qfirehose-edl-guard stop-services
        ;;
    usb_device:remove)
        /usr/sbin/qfirehose-edl-guard restore-services "" force
        ;;
esac
